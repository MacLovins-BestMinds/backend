PROJECT_NAME="Stage Zero Backend"
HOST=0.0.0.0
PORT=8000

# PostgreSQL (по умолчанию для Docker и продакшена):
DATABASE_URL=postgresql://stage_zero:stage_zero_password@localhost:5432/stage_zero
# Для локального запуска без запущенного PostgreSQL:
# DATABASE_URL=sqlite:///stage_zero.db

CORS_ORIGINS="*"
MOCK_FALLBACK=true

# Auth (JWT & Google OAuth)
JWT_SECRET_KEY=stage_zero_super_secret_jwt_key_2026_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- AI-движок (/api/ai) ---
# Ключи только на сервере: телефон шлёт звук в наш бэкенд, ключи в приложение не попадают.
# Без обязательных ключей сервер не стартует (AI_MOCK=1 — запуск на моках без ключей).

# ElevenLabs — распознавание (Scribe) и голоса жюри. Ключ: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID: https://elevenlabs.io/app/voice-library → голос → «ID» (или My Voices → ⋯ → Copy voice ID)
ELEVENLABS_VOICE_ID=           # общий голос жюри
ELEVENLABS_VOICE_ID_STRICT=    # необязательно: свои голоса для трёх членов жюри (по ТЗ голоса разные)
ELEVENLABS_VOICE_ID_KIND=
ELEVENLABS_VOICE_ID_SKEPTIC=

# Gemini — оценка содержания, вопросы жюри, refine. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash   # если основная перегружена (503); пусто — без запасной

# Распознавание записей (delivery, ответы жюри): elevenlabs | openai
STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v2            # openai: whisper-1
STT_LANGUAGE=ru

# Живое распознавание для реакций зала (WS /api/ai/live): elevenlabs | deepgram
LIVE_STT_PROVIDER=elevenlabs
LIVE_STT_MODEL=scribe_v2_realtime

# Голоса жюри: elevenlabs | openai
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5    # openai: gpt-4o-mini-tts

# Запасные провайдеры — нужны, только если переключить *_PROVIDER обратно
OPENAI_API_KEY=                # STT_PROVIDER=openai / TTS_PROVIDER=openai: https://platform.openai.com/api-keys
DEEPGRAM_API_KEY=              # LIVE_STT_PROVIDER=deepgram: https://console.deepgram.com
DEEPGRAM_MODEL=nova-3

# Режимы
AI_MOCK=0                      # 1 — все /api/ai/* отвечают моками без ключей (то же, что ?mock=1)
AI_CACHE=1                     # 0 — выключить дисковый кэш ответов AI
AI_CACHE_DIR=.ai_cache         # папка кэша; удалить, чтобы сбросить

# Файлы
STATIC_DIR=static              # сюда пишутся mp3 вопросов жюри, раздаются по /static/
MAX_AUDIO_MB=25
